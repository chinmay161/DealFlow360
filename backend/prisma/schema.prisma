generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SALES_REP
  APPROVER
  CUSTOMER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      UserRole @default(SALES_REP)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
