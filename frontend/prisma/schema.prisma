generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────────
// Enumerations
// ──────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  SALES_REP
  APPROVER
  CUSTOMER
}

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum QuotationStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
  CANCELLED
}

enum ApprovalPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkflowStepStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  SKIPPED
}

// ──────────────────────────────────────────────────────────────────────────────
// Authentication & User Model
// ──────────────────────────────────────────────────────────────────────────────

model User {
  id                 String                 @id @default(uuid())
  email              String                 @unique
  name               String?
  emailVerified      DateTime?
  image              String?
  avatarUrl          String?
  role               UserRole               @default(SALES_REP)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  accounts           Account[]
  sessions           Session[]

  ownedQuotations    Quotation[]            @relation("QuotationOwner")
  ownedCustomers     Customer[]             @relation("CustomerOwner")
  contacts           Contact[]
  requestedApprovals Approval[]             @relation("ApprovalRequester")
  assignedApprovals  Approval[]             @relation("ApprovalAssignee")
  workflowSteps      ApprovalWorkflowStep[] @relation("StepApprover")
  approvalHistories  ApprovalHistory[]      @relation("HistoryActor")
}

// ──────────────────────────────────────────────────────────────────────────────
// Customer & Contact Models
// ──────────────────────────────────────────────────────────────────────────────

model Customer {
  id                String         @id @default(uuid())
  name              String
  externalAccountId String?
  industry          String?
  tier              CustomerTier   @default(BRONZE)
  paymentTerms      String?        @default("Net 30 Days")
  creditLimit       Decimal        @default(100000.00) @db.Decimal(14, 2)
  creditAvailable   Decimal        @default(100000.00) @db.Decimal(14, 2)
  territory         String?
  ownerId           String?
  owner             User?          @relation("CustomerOwner", fields: [ownerId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  quotations        Quotation[]
  contacts          Contact[]
  subscriptions     Subscription[]

  @@index([tier])
  @@index([ownerId])
}

model Contact {
  id           String    @id @default(uuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId       String?   @unique
  user         User?     @relation(fields: [userId], references: [id])
  name         String
  email        String
  phone        String?
  title        String?
  isPrimary    Boolean   @default(false)
  portalAccess Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([customerId])
  @@index([email])
}

// ──────────────────────────────────────────────────────────────────────────────
// Product Catalog & Hierarchy
// ──────────────────────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
}

model Product {
  id                     String                  @id @default(uuid())
  sku                    String                  @unique
  name                   String
  description            String?
  categoryId             String
  category               Category                @relation(fields: [categoryId], references: [id])
  unitPrice              Decimal                 @db.Decimal(14, 2)
  costPrice              Decimal                 @db.Decimal(14, 2)
  taxRate                Decimal                 @default(0.00) @db.Decimal(5, 2)
  unit                   String                  @default("unit")
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  priceListItems         PriceListItem[]
  inventoryItems         InventoryItem[]
  quoteLineItems         QuoteLineItem[]
  recommendationsAsSource ProductRecommendation[] @relation("SourceProduct")
  recommendationsAsTarget ProductRecommendation[] @relation("TargetProduct")

  @@index([sku])
  @@index([categoryId])
  @@index([isActive])
}

// ──────────────────────────────────────────────────────────────────────────────
// Quotation & Quote Line Items
// ──────────────────────────────────────────────────────────────────────────────

model Quotation {
  id              String            @id @default(uuid())
  quotationNumber String            @unique
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ownerId         String
  owner           User              @relation("QuotationOwner", fields: [ownerId], references: [id])
  status          QuotationStatus   @default(DRAFT)
  currentStage    String?
  currency        String            @default("USD")
  subtotal        Decimal           @default(0.00) @db.Decimal(14, 2)
  discountTotal   Decimal           @default(0.00) @db.Decimal(14, 2)
  taxTotal        Decimal           @default(0.00) @db.Decimal(14, 2)
  totalValue      Decimal           @default(0.00) @db.Decimal(14, 2)
  estimatedMargin Decimal           @default(0.00) @db.Decimal(5, 2)
  riskScore       Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  lineItems       QuoteLineItem[]
  approvals       Approval[]
  subscriptions   Subscription[]

  @@index([customerId])
  @@index([ownerId])
  @@index([status])
}

model QuoteLineItem {
  id                     String    @id @default(uuid())
  quotationId            String
  quotation              Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId              String?
  product                Product?  @relation(fields: [productId], references: [id])
  productName            String
  sku                    String?
  quantity               Int       @default(1)
  unitPrice              Decimal   @default(0.00) @db.Decimal(14, 2)
  discountPercent        Decimal   @default(0.00) @db.Decimal(5, 2)
  discountLimitPercent   Decimal?  @db.Decimal(5, 2)
  estimatedMarginPercent Decimal?  @db.Decimal(5, 2)
  lineTotal              Decimal   @default(0.00) @db.Decimal(14, 2)
  governanceStatus       String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([quotationId])
  @@index([productId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Price Lists
// ──────────────────────────────────────────────────────────────────────────────

model PriceList {
  id          String          @id @default(uuid())
  name        String
  code        String          @unique
  description String?
  currency    String          @default("USD")
  tier        CustomerTier?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items       PriceListItem[]

  @@index([code])
  @@index([tier])
}

model PriceListItem {
  id          String    @id @default(uuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  price       Decimal   @db.Decimal(14, 2)
  minQuantity Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([priceListId, productId])
  @@index([productId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Discount Governance Rules
// ──────────────────────────────────────────────────────────────────────────────

model DiscountRule {
  id                 String        @id @default(uuid())
  name               String
  code               String        @unique
  description        String?
  category           String?
  tier               CustomerTier?
  maxDiscountPercent Decimal       @db.Decimal(5, 2)
  requiredRole       String
  requiresApproval   Boolean       @default(true)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([code])
}

// ──────────────────────────────────────────────────────────────────────────────
// Product Recommendations
// ──────────────────────────────────────────────────────────────────────────────

model ProductRecommendation {
  id                  String   @id @default(uuid())
  sourceProductId     String
  sourceProduct       Product  @relation("SourceProduct", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProductId     String
  targetProduct       Product  @relation("TargetProduct", fields: [targetProductId], references: [id], onDelete: Cascade)
  recommendationType  String   // CROSS_SELL, UPSELL, BUNDLE
  rationale           String
  confidenceScore     Decimal  @db.Decimal(5, 2)
  estimatedMarginGain Decimal? @db.Decimal(14, 2)
  priority            Int      @default(1)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([sourceProductId])
  @@index([targetProductId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Warehouses & Inventory
// ──────────────────────────────────────────────────────────────────────────────

model Warehouse {
  id        String          @id @default(uuid())
  code      String          @unique
  name      String
  location  String
  country   String          @default("USA")
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  inventory InventoryItem[]

  @@index([code])
}

model InventoryItem {
  id                String    @id @default(uuid())
  warehouseId       String
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityOnHand    Int       @default(0)
  quantityReserved  Int       @default(0)
  quantityAvailable Int       @default(0)
  reorderPoint      Int       @default(10)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@index([productId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Subscriptions & Recurring Plans
// ──────────────────────────────────────────────────────────────────────────────

model SubscriptionPlan {
  id           String         @id @default(uuid())
  code         String         @unique
  name         String
  description  String?
  interval     String         @default("MONTHLY") // MONTHLY, ANNUAL
  billingPrice Decimal        @db.Decimal(14, 2)
  currency     String         @default("USD")
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  subscriptions Subscription[]

  @@index([code])
}

model Subscription {
  id                 String           @id @default(uuid())
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotationId        String?
  quotation          Quotation?       @relation(fields: [quotationId], references: [id])
  planId             String
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])
  status             String           @default("ACTIVE")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  mrr                Decimal          @db.Decimal(14, 2)
  arr                Decimal          @db.Decimal(14, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([customerId])
  @@index([planId])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────────────────────
// Approvals & Workflow Governance
// ──────────────────────────────────────────────────────────────────────────────

model Approval {
  id            String                 @id @default(uuid())
  quotationId   String
  quotation     Quotation              @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  status        ApprovalStatus         @default(PENDING)
  priority      ApprovalPriority       @default(MEDIUM)
  currentStep   Int                    @default(1)
  requestedById String
  requestedBy   User                   @relation("ApprovalRequester", fields: [requestedById], references: [id])
  assignedToId  String?
  assignedTo    User?                  @relation("ApprovalAssignee", fields: [assignedToId], references: [id])
  submittedAt   DateTime               @default(now())
  resolvedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  workflowSteps ApprovalWorkflowStep[]
  history       ApprovalHistory[]

  @@index([quotationId])
  @@index([requestedById])
  @@index([assignedToId])
  @@index([status])
}

model ApprovalWorkflowStep {
  id          String             @id @default(uuid())
  approvalId  String
  approval    Approval           @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  stepOrder   Int
  role        String
  approverId  String?
  approver    User?              @relation("StepApprover", fields: [approverId], references: [id])
  status      WorkflowStepStatus @default(PENDING)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([approvalId])
  @@index([approverId])
}

model ApprovalHistory {
  id         String   @id @default(uuid())
  approvalId String
  approval   Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation("HistoryActor", fields: [actorId], references: [id])
  eventType  String
  message    String
  createdAt  DateTime @default(now())

  @@index([approvalId])
  @@index([actorId])
}

// ──────────────────────────────────────────────────────────────────────────────
// NextAuth Models
// ──────────────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
