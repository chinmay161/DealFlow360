generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────────
// Enumerations
// ──────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  SALES_REP
  MANAGER
  FINANCE
  EXECUTIVE
  OPERATIONS
  APPROVER
  CUSTOMER
}

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  IN_REVIEW
  APPROVED
  REJECTED
  SENT
  ACCEPTED
  EXPIRED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
  CANCELLED
}

enum ApprovalPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkflowStepStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  SKIPPED
}

enum RuleOutcome {
  PASS
  FAIL
  WARN
  SKIP
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_FULFILLMENT
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum ShipmentStatus {
  PLANNED
  READY
  PICKED
  PACKED
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

// ──────────────────────────────────────────────────────────────────────────────
// Authentication & User Model
// ──────────────────────────────────────────────────────────────────────────────

model User {
  id                 String                 @id @default(uuid())
  email              String                 @unique
  name               String?
  emailVerified      DateTime?
  image              String?
  avatarUrl          String?
  role               UserRole               @default(SALES_REP)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  accounts           Account[]
  sessions           Session[]

  ownedQuotations    Quotation[]            @relation("QuotationOwner")
  ownedCustomers     Customer[]             @relation("CustomerOwner")
  contacts           Contact[]
  requestedApprovals Approval[]             @relation("ApprovalRequester")
  assignedApprovals  Approval[]             @relation("ApprovalAssignee")
  workflowSteps      ApprovalWorkflowStep[] @relation("StepApprover")
  approvalHistories  ApprovalHistory[]      @relation("HistoryActor")
}

// ──────────────────────────────────────────────────────────────────────────────
// Customer & Contact Models
// ──────────────────────────────────────────────────────────────────────────────

model Customer {
  id                String         @id @default(uuid())
  customerNumber    String?        @unique
  name              String
  externalAccountId String?
  industry          String?
  otherIndustryDetails String?
  tier              CustomerTier   @default(BRONZE)
  paymentTerms      String?        @default("Net 30 Days")
  creditLimit       Decimal        @default(100000.00) @db.Decimal(14, 2)
  creditAvailable   Decimal        @default(100000.00) @db.Decimal(14, 2)
  territory         String?
  city              String?
  state             String?
  country           String?        @default("India")
  ownerId           String?
  owner             User?          @relation("CustomerOwner", fields: [ownerId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  quotations        Quotation[]
  contacts          Contact[]
  subscriptions     Subscription[]
  orders            Order[]
  invoices          Invoice[]

  @@index([tier])
  @@index([ownerId])
  @@index([customerNumber])
}

model Contact {
  id                  String    @id @default(uuid())
  customerId          String
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId              String?   @unique
  user                User?     @relation(fields: [userId], references: [id])
  name                String
  email               String    @unique
  phone               String?
  title               String?
  isPrimary           Boolean   @default(false)
  portalAccess        Boolean   @default(false)
  portalAccessEnabled Boolean   @default(false)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([customerId])
  @@index([email])
}

model PortalLoginIntent {
  id         String    @id @default(uuid())
  token      String    @unique
  email      String
  contactId  String
  customerId String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([token])
  @@index([email])
}

// ──────────────────────────────────────────────────────────────────────────────
// Product Catalog & Hierarchy
// ──────────────────────────────────────────────────────────────────────────────

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
}

model Product {
  id                     String                  @id @default(uuid())
  sku                    String                  @unique
  name                   String
  description            String?
  categoryId             String
  category               Category                @relation(fields: [categoryId], references: [id])
  unitPrice              Decimal                 @db.Decimal(14, 2)
  costPrice              Decimal                 @db.Decimal(14, 2)
  taxRate                Decimal                 @default(0.00) @db.Decimal(5, 2)
  unit                   String                  @default("unit")
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  priceListItems         PriceListItem[]
  inventoryItems         InventoryItem[]
  quoteLineItems         QuoteLineItem[]
  recommendationsAsSource ProductRecommendation[] @relation("SourceProduct")
  recommendationsAsTarget ProductRecommendation[] @relation("TargetProduct")
  orderLines             OrderLine[]
  reservations           InventoryReservation[]
  shipmentItems          ShipmentItem[]

  @@index([sku])
  @@index([categoryId])
  @@index([isActive])
}

// ──────────────────────────────────────────────────────────────────────────────
// Quotation & Quote Line Items
// ──────────────────────────────────────────────────────────────────────────────

model Quotation {
  id              String            @id @default(uuid())
  quotationNumber String            @unique
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ownerId         String
  owner           User              @relation("QuotationOwner", fields: [ownerId], references: [id])
  status          QuotationStatus   @default(DRAFT)
  currentStage    String?
  currency        String            @default("INR")
  subtotal        Decimal           @default(0.00) @db.Decimal(14, 2)
  discountTotal   Decimal           @default(0.00) @db.Decimal(14, 2)
  taxTotal        Decimal           @default(0.00) @db.Decimal(14, 2)
  totalValue      Decimal           @default(0.00) @db.Decimal(14, 2)
  estimatedMargin Decimal           @default(0.00) @db.Decimal(5, 2)
  riskScore       Int?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  lineItems       QuoteLineItem[]
  approvals       Approval[]
  subscriptions   Subscription[]
  ruleEvaluations RuleEvaluation[]
  decisionTraces  DecisionTrace[]
  counterfactuals CounterfactualScenario[]
  orders          Order[]
  reservations    InventoryReservation[]
  invoices        Invoice[]
  negotiations    CustomerNegotiation[]

  @@index([customerId])
  @@index([ownerId])
  @@index([status])
}

model QuoteLineItem {
  id                     String    @id @default(uuid())
  quotationId            String
  quotation              Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId              String?
  product                Product?  @relation(fields: [productId], references: [id])
  productName            String
  sku                    String?
  quantity               Int       @default(1)
  unitPrice              Decimal   @default(0.00) @db.Decimal(14, 2)
  discountPercent        Decimal   @default(0.00) @db.Decimal(5, 2)
  discountLimitPercent   Decimal?  @db.Decimal(5, 2)
  estimatedMarginPercent Decimal?  @db.Decimal(5, 2)
  lineTotal              Decimal   @default(0.00) @db.Decimal(14, 2)
  governanceStatus       String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([quotationId])
  @@index([productId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Price Lists
// ──────────────────────────────────────────────────────────────────────────────

model PriceList {
  id          String          @id @default(uuid())
  name        String
  code        String          @unique
  description String?
  currency    String          @default("INR")
  tier        CustomerTier?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  items       PriceListItem[]

  @@index([code])
  @@index([tier])
}

model PriceListItem {
  id          String    @id @default(uuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  price       Decimal   @db.Decimal(14, 2)
  minQuantity Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([priceListId, productId])
  @@index([productId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Discount Governance Rules
// ──────────────────────────────────────────────────────────────────────────────

model DiscountRule {
  id                 String        @id @default(uuid())
  name               String
  code               String        @unique
  description        String?
  category           String?
  tier               CustomerTier?
  maxDiscountPercent Decimal       @db.Decimal(5, 2)
  requiredRole       String
  requiresApproval   Boolean       @default(true)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([code])
}

// ──────────────────────────────────────────────────────────────────────────────
// Product Recommendations
// ──────────────────────────────────────────────────────────────────────────────

model ProductRecommendation {
  id                  String   @id @default(uuid())
  sourceProductId     String
  sourceProduct       Product  @relation("SourceProduct", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProductId     String
  targetProduct       Product  @relation("TargetProduct", fields: [targetProductId], references: [id], onDelete: Cascade)
  recommendationType  String   // CROSS_SELL, UPSELL, BUNDLE
  rationale           String
  confidenceScore     Decimal  @db.Decimal(5, 2)
  estimatedMarginGain Decimal? @db.Decimal(14, 2)
  priority            Int      @default(1)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([sourceProductId])
  @@index([targetProductId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Warehouses & Inventory
// ──────────────────────────────────────────────────────────────────────────────

model Warehouse {
  id           String          @id @default(uuid())
  code         String          @unique
  name         String
  location     String
  country      String          @default("India")
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  inventory    InventoryItem[]
  reservations InventoryReservation[]
  shipments    Shipment[]

  @@index([code])
}

model InventoryItem {
  id                String    @id @default(uuid())
  warehouseId       String
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityOnHand    Int       @default(0)
  quantityReserved  Int       @default(0)
  quantityAvailable Int       @default(0)
  reorderPoint      Int       @default(10)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([warehouseId, productId])
  @@index([productId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Subscriptions & Recurring Plans
// ──────────────────────────────────────────────────────────────────────────────

model SubscriptionPlan {
  id           String         @id @default(uuid())
  code         String         @unique
  name         String
  description  String?
  interval     String         @default("MONTHLY") // MONTHLY, ANNUAL
  billingPrice Decimal        @db.Decimal(14, 2)
  currency     String         @default("INR")
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  subscriptions Subscription[]

  @@index([code])
}

model Subscription {
  id                 String           @id @default(uuid())
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotationId        String?
  quotation          Quotation?       @relation(fields: [quotationId], references: [id])
  planId             String
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])
  status             String           @default("ACTIVE")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  mrr                Decimal          @db.Decimal(14, 2)
  arr                Decimal          @db.Decimal(14, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([customerId])
  @@index([planId])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────────────────────
// Approvals & Workflow Governance
// ──────────────────────────────────────────────────────────────────────────────

model Approval {
  id            String                 @id @default(uuid())
  quotationId   String
  quotation     Quotation              @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  status        ApprovalStatus         @default(PENDING)
  priority      ApprovalPriority       @default(MEDIUM)
  currentStep   Int                    @default(1)
  requestedById String
  requestedBy   User                   @relation("ApprovalRequester", fields: [requestedById], references: [id])
  assignedToId  String?
  assignedTo    User?                  @relation("ApprovalAssignee", fields: [assignedToId], references: [id])
  submittedAt   DateTime               @default(now())
  resolvedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  workflowSteps ApprovalWorkflowStep[]
  history       ApprovalHistory[]

  @@index([quotationId])
  @@index([requestedById])
  @@index([assignedToId])
  @@index([status])
}

model ApprovalWorkflowStep {
  id          String             @id @default(uuid())
  approvalId  String
  approval    Approval           @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  stepOrder   Int
  role        String
  approverId  String?
  approver    User?              @relation("StepApprover", fields: [approverId], references: [id])
  status      WorkflowStepStatus @default(PENDING)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([approvalId])
  @@index([approverId])
}

model ApprovalHistory {
  id         String   @id @default(uuid())
  approvalId String
  approval   Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation("HistoryActor", fields: [actorId], references: [id])
  eventType  String
  message    String
  createdAt  DateTime @default(now())

  @@index([approvalId])
  @@index([actorId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Governance: Rule Engine & Decision Trace
// ──────────────────────────────────────────────────────────────────────────────

model RuleEvaluation {
  id           String         @id @default(uuid())
  quotationId  String
  quotation    Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  ruleId       String
  ruleName     String
  outcome      RuleOutcome    @default(PASS)
  severity     String         @default("INFO")
  score        Float          @default(0)
  message      String?
  metadata     Json?
  createdAt    DateTime       @default(now())

  decisionTrace DecisionTrace?

  @@index([quotationId])
  @@index([ruleId])
}

model DecisionTrace {
  id            String          @id @default(uuid())
  quotationId   String
  quotation     Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  evaluationId  String?         @unique
  evaluation    RuleEvaluation? @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  summary       String
  riskScore     Float
  approvalLevel String
  details       Json?
  createdAt     DateTime        @default(now())

  @@index([quotationId])
}

model CounterfactualScenario {
  id           String    @id @default(uuid())
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  title        String
  description  String
  currentValue Float
  targetValue  Float
  diffPercent  Float
  impact       String
  applied      Boolean   @default(false)
  metadata     Json?
  createdAt    DateTime  @default(now())

  @@index([quotationId])
}

model AuditLog {
  id         String    @id @default(uuid())
  entity     String
  entityId   String
  action     String
  actorId    String?
  actorEmail String?
  fromState  String?
  toState    String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// Operations: Orders, Reservations & Shipments
// ──────────────────────────────────────────────────────────────────────────────

model Order {
  id              String                 @id @default(uuid())
  orderNumber     String                 @unique
  quotationId     String?                @unique
  quotation       Quotation?             @relation(fields: [quotationId], references: [id])
  customerId      String
  customer        Customer               @relation(fields: [customerId], references: [id])
  status          OrderStatus            @default(CONFIRMED)
  totalAmount     Decimal                @db.Decimal(14, 2)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  orderLines      OrderLine[]
  reservations    InventoryReservation[]
  shipments       Shipment[]
  invoices        Invoice[]

  @@index([quotationId])
  @@index([customerId])
  @@index([status])
}

model OrderLine {
  id          String    @id @default(uuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Decimal   @db.Decimal(14, 2)
  lineTotal   Decimal   @db.Decimal(14, 2)
  itemType    String    @default("PHYSICAL") // PHYSICAL, SERVICE, SUBSCRIPTION

  @@index([orderId])
  @@index([productId])
}

model InventoryReservation {
  id             String     @id @default(uuid())
  orderId        String?
  order          Order?     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quotationId    String?
  quotation      Quotation? @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse  @relation(fields: [warehouseId], references: [id])
  productId      String
  product        Product    @relation(fields: [productId], references: [id])
  quantity       Int
  status         String     @default("CONFIRMED") // CONFIRMED, FULFILLED, RELEASED
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([orderId])
  @@index([quotationId])
  @@index([warehouseId])
  @@index([productId])
}

model Shipment {
  id             String         @id @default(uuid())
  shipmentNumber String         @unique
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])
  trackingCode   String?
  carrier        String         @default("Express Logistics")
  status         ShipmentStatus @default(PLANNED)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items          ShipmentItem[]

  @@index([orderId])
  @@index([warehouseId])
  @@index([status])
}

model ShipmentItem {
  id          String    @id @default(uuid())
  shipmentId  String
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int

  @@index([shipmentId])
  @@index([productId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Operations: Billing, Invoicing & Payments
// ──────────────────────────────────────────────────────────────────────────────

model Invoice {
  id            String         @id @default(uuid())
  invoiceNumber String         @unique
  orderId       String?
  order         Order?         @relation(fields: [orderId], references: [id])
  quotationId   String?
  quotation     Quotation?     @relation(fields: [quotationId], references: [id])
  customerId    String
  customer      Customer       @relation(fields: [customerId], references: [id])
  status        InvoiceStatus  @default(DRAFT)
  subtotal      Decimal        @db.Decimal(14, 2)
  taxAmount     Decimal        @db.Decimal(14, 2)
  totalAmount   Decimal        @db.Decimal(14, 2)
  paidAmount    Decimal        @default(0.00) @db.Decimal(14, 2)
  balanceDue    Decimal        @db.Decimal(14, 2)
  paymentTerms  String         @default("Net 30 Days")
  dueDate       DateTime
  issuedAt      DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  lines         InvoiceLine[]
  payments      Payment[]
  creditNotes   CreditNote[]

  @@index([orderId])
  @@index([quotationId])
  @@index([customerId])
  @@index([status])
}

model InvoiceLine {
  id          String    @id @default(uuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sku         String
  description String
  quantity    Int
  unitPrice   Decimal   @db.Decimal(14, 2)
  lineTotal   Decimal   @db.Decimal(14, 2)
  chargeType  String    @default("ONE_TIME") // ONE_TIME, RECURRING
  taxRate     Decimal   @default(18.00) @db.Decimal(5, 2)

  @@index([invoiceId])
}

model Payment {
  id              String    @id @default(uuid())
  paymentNumber   String    @unique
  invoiceId       String
  invoice         Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount          Decimal   @db.Decimal(14, 2)
  paymentMethod   String    @default("BANK_TRANSFER")
  referenceNumber String?
  status          String    @default("COMPLETED")
  paidAt          DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@index([invoiceId])
}

model CreditNote {
  id               String    @id @default(uuid())
  creditNoteNumber String    @unique
  invoiceId        String
  invoice          Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount           Decimal   @db.Decimal(14, 2)
  reason           String
  issuedAt         DateTime  @default(now())
  createdAt        DateTime  @default(now())

  @@index([invoiceId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Customer Portal & Negotiation
// ──────────────────────────────────────────────────────────────────────────────

model CustomerNegotiation {
  id          String     @id @default(uuid())
  quotationId String
  quotation   Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String
  authorRole  String     // "CUSTOMER" | "INTERNAL"
  message     String
  eventType   String     // "COMMENT" | "COUNTER_OFFER" | "ACCEPTANCE" | "REJECTION"
  changes     Json?
  createdAt   DateTime   @default(now())

  @@index([quotationId])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// NextAuth Models
// ──────────────────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ──────────────────────────────────────────────────────────────────────────────
// Configuration & Commercial Policy Rules
// ──────────────────────────────────────────────────────────────────────────────

model DiscountPolicy {
  id              String        @id @default(uuid())
  name            String        @unique
  description     String?
  type            String        @default("PERCENTAGE")
  value           Decimal       @db.Decimal(14, 2)
  minOrderAmt     Decimal?      @db.Decimal(14, 2)
  maxDiscount     Decimal?      @db.Decimal(14, 2)
  tier            CustomerTier?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tier])
  @@index([isActive])
}

model ApprovalRule {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  stage         Int      @default(1)
  threshold     Decimal  @db.Decimal(14, 2)
  approverRole  String   @default("MANAGER")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([stage])
  @@index([isActive])
}

